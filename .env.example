# Copy to .env and change the values: cp .env.example .env
# .env is git-ignored. Never commit real credentials.

# PostgreSQL
POSTGRES_USER=devspeak
# The password is used inside a connection URL: avoid @ : / ? # characters.
POSTGRES_PASSWORD=change-me
POSTGRES_DB=devspeak
# DB host for the Go API (localhost when the API runs on your machine).
POSTGRES_HOST=localhost
# Host port for the DB (container port is always 5432).
POSTGRES_PORT=5432

# Go API
HTTP_ADDR=:8080
